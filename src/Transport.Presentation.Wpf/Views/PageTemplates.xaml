<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Transport.Presentation.Wpf.ViewModels.Pages"
                    xmlns:pages="clr-namespace:Transport.Presentation.Wpf.Views.Pages">
    <!-- Mỗi trang một DataTemplate: ViewModel -> View -->
    <DataTemplate DataType="{x:Type vm:RoutesViewModel}"><pages:RoutesPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:VehiclesViewModel}"><pages:VehiclesPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DriversViewModel}"><pages:DriversPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:PassengersViewModel}"><pages:PassengersPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SchedulesViewModel}"><pages:SchedulesPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SellTicketViewModel}"><pages:SellTicketPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TicketsViewModel}"><pages:TicketsPage /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:StatisticsViewModel}"><pages:StatisticsPage /></DataTemplate>
</ResourceDictionary>
