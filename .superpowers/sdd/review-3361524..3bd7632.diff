diff --git a/database/03_triggers.sql b/database/03_triggers.sql new file mode 100644 index 0000000..3666199 --- /dev/null +++ b/database/03_triggers.sql @@ -0,0 +1,89 @@ +WHENEVER SQLERROR EXIT FAILURE ROLLBACK +SET DEFINE OFF +SET SQLBLANKLINES ON +SET SERVEROUTPUT ON SIZE UNLIMITED + +-- Kiß╗âm tra ghß║┐ hß╗úp lß╗ç v├á ch╞░a bß╗ï ─æß║╖t. +-- Gom c├íc d├▓ng ß╗ƒ AFTER EACH ROW, kiß╗âm tra ß╗ƒ AFTER STATEMENT ─æß╗â tr├ính lß╗ùi mutating table. +CREATE OR REPLACE TRIGGER trg_tickets_check_seat +FOR INSERT OR UPDATE OF seat_no, schedule_id, status ON tickets +COMPOUND TRIGGER +  TYPE t_id_list IS TABLE OF tickets.ticket_id%TYPE; +  g_ids t_id_list := t_id_list(); + +  AFTER EACH ROW IS +  BEGIN +    -- V├⌐ bß╗ï hß╗ºy th├¼ kh├┤ng cß║ºn kiß╗âm tra +    IF :NEW.status <> 'CANCELLED' THEN +      g_ids.EXTEND; +      g_ids(g_ids.LAST) := :NEW.ticket_id; +    END IF; +  END AFTER EACH ROW; + +  AFTER STATEMENT IS +    v_seat_no    tickets.seat_no%TYPE; +    v_sched_id   tickets.schedule_id%TYPE; +    v_capacity   vehicles.seat_count%TYPE; +    v_sched_stat schedules.status%TYPE; +    v_taken      NUMBER; +  BEGIN +    FOR i IN 1 .. g_ids.COUNT LOOP +      SELECT t.seat_no, t.schedule_id, v.seat_count, s.status +        INTO v_seat_no, v_sched_id, v_capacity, v_sched_stat +        FROM tickets t +        JOIN schedules s ON s.schedule_id = t.schedule_id +        JOIN vehicles  v ON v.vehicle_id  = s.vehicle_id +       WHERE t.ticket_id = g_ids(i); + +      -- Ghß║┐ phß║úi nß║▒m trong sß╗⌐c chß╗⌐a cß╗ºa xe +      IF v_seat_no NOT BETWEEN 1 AND v_capacity THEN +        RAISE_APPLICATION_ERROR(-20001, 'Seat ' || v_seat_no || ' does not exist (vehicle has ' || v_capacity || ' seats).'); +      END IF; + +      -- Chß╗ë b├ín/thanh to├ín v├⌐ cho chuyß║┐n ch╞░a chß║íy +      IF v_sched_stat <> 'SCHEDULED' THEN +        RAISE_APPLICATION_ERROR(-20002, 'Schedule is not open for sale (status ' || v_sched_stat || ').'); +      END IF; + +      -- Mß╗ùi ghß║┐ chß╗ë c├│ ─æ├║ng 1 v├⌐ ─æang hiß╗çu lß╗▒c +      SELECT COUNT(*) INTO v_taken +        FROM tickets +       WHERE schedule_id = v_sched_id AND seat_no = v_seat_no AND status <> 'CANCELLED'; +      IF v_taken > 1 THEN +        RAISE_APPLICATION_ERROR(-20003, 'Seat ' || v_seat_no || ' is already booked.'); +      END IF; +    END LOOP; +  END AFTER STATEMENT; +END; +/ + +-- Kh├┤ng cho chuyß╗ân chuyß║┐n sang CANCELLED nß║┐u c├▓n v├⌐ hiß╗çu lß╗▒c +CREATE OR REPLACE TRIGGER trg_schedules_check_cancel +BEFORE UPDATE OF status ON schedules +FOR EACH ROW +WHEN (NEW.status = 'CANCELLED' AND OLD.status <> 'CANCELLED') +DECLARE +  v_active NUMBER; +BEGIN +  SELECT COUNT(*) INTO v_active +    FROM tickets +   WHERE schedule_id = :NEW.schedule_id AND status <> 'CANCELLED'; +  IF v_active > 0 THEN +    RAISE_APPLICATION_ERROR(-20052, 'Schedule has active tickets; use PKG_SCHEDULE.CANCEL_SCHEDULE.'); +  END IF; +END; +/ + +-- Dß╗½ng nß║┐u c├│ object bß╗ï lß╗ùi bi├¬n dß╗ïch +SELECT name, type, line, text FROM user_errors ORDER BY name, sequence; +DECLARE +  v_errors NUMBER; +BEGIN +  SELECT COUNT(*) INTO v_errors FROM user_errors; +  IF v_errors > 0 THEN +    RAISE_APPLICATION_ERROR(-20999, 'Compilation errors: ' || v_errors); +  END IF; +END; +/ + +EXIT diff --git a/database/04_packages.sql b/database/04_packages.sql new file mode 100644 index 0000000..4c641bb --- /dev/null +++ b/database/04_packages.sql @@ -0,0 +1,150 @@ +WHENEVER SQLERROR EXIT FAILURE ROLLBACK +SET DEFINE OFF +SET SQLBLANKLINES ON +SET SERVEROUTPUT ON SIZE UNLIMITED + +CREATE OR REPLACE PACKAGE pkg_ticket AS +  -- ─Éß║╖t v├⌐: t├¼m h├ánh kh├ích theo S─ÉT, ch╞░a c├│ th├¼ tß║ío mß╗¢i +  PROCEDURE book_ticket(p_schedule_id IN NUMBER, p_full_name IN VARCHAR2, p_phone IN VARCHAR2, +                        p_id_card IN VARCHAR2, p_seat_no IN NUMBER, o_ticket_id OUT NUMBER); +  -- Thanh to├ín v├⌐ ─æang ß╗ƒ trß║íng th├íi BOOKED +  PROCEDURE pay_ticket(p_ticket_id IN NUMBER, p_method IN VARCHAR2); +  -- Hß╗ºy v├⌐; v├⌐ ─æ├ú thanh to├ín th├¼ ghi th├¬m d├▓ng ho├án tiß╗ün 100% +  PROCEDURE cancel_ticket(p_ticket_id IN NUMBER, p_reason IN VARCHAR2); +END pkg_ticket; +/ + +CREATE OR REPLACE PACKAGE BODY pkg_ticket AS + +  PROCEDURE book_ticket(p_schedule_id IN NUMBER, p_full_name IN VARCHAR2, p_phone IN VARCHAR2, +                        p_id_card IN VARCHAR2, p_seat_no IN NUMBER, o_ticket_id OUT NUMBER) IS +    v_price     schedules.ticket_price%TYPE; +    v_departure schedules.departure_time%TYPE; +    v_pass_id   passengers.passenger_id%TYPE; +  BEGIN +    -- Kh├│a d├▓ng lß╗ïch chß║íy ─æß╗â c├íc quß║ºy b├ín c├╣ng chuyß║┐n xß║┐p h├áng, kh├┤ng tranh ghß║┐ +    SELECT ticket_price, departure_time INTO v_price, v_departure +      FROM schedules WHERE schedule_id = p_schedule_id FOR UPDATE; + +    IF v_departure <= SYSDATE THEN +      RAISE_APPLICATION_ERROR(-20010, 'Schedule has already departed; booking not allowed.'); +    END IF; + +    -- T├¼m hoß║╖c tß║ío h├ánh kh├ích theo sß╗æ ─æiß╗çn thoß║íi +    MERGE INTO passengers p +    USING (SELECT p_phone AS phone FROM dual) x ON (p.phone = x.phone) +    WHEN MATCHED THEN UPDATE SET p.full_name = p_full_name, p.id_card = NVL(p_id_card, p.id_card) +    WHEN NOT MATCHED THEN INSERT (full_name, phone, id_card) VALUES (p_full_name, p_phone, p_id_card); +    SELECT passenger_id INTO v_pass_id FROM passengers WHERE phone = p_phone; + +    -- Trigger trg_tickets_check_seat kiß╗âm tra ghß║┐ +    INSERT INTO tickets (schedule_id, passenger_id, seat_no, price) +    VALUES (p_schedule_id, v_pass_id, p_seat_no, v_price) +    RETURNING ticket_id INTO o_ticket_id; +    COMMIT; +  EXCEPTION +    WHEN NO_DATA_FOUND THEN ROLLBACK; RAISE_APPLICATION_ERROR(-20011, 'Schedule not found.'); +    WHEN OTHERS THEN ROLLBACK; RAISE; +  END book_ticket; + +  PROCEDURE pay_ticket(p_ticket_id IN NUMBER, p_method IN VARCHAR2) IS +    v_status tickets.status%TYPE; +    v_price  tickets.price%TYPE; +  BEGIN +    SELECT status, price INTO v_status, v_price FROM tickets WHERE ticket_id = p_ticket_id FOR UPDATE; +    IF v_status <> 'BOOKED' THEN +      RAISE_APPLICATION_ERROR(-20020, 'Only BOOKED tickets can be paid.'); +    END IF; +    INSERT INTO payments (ticket_id, amount, method, payment_type) +    VALUES (p_ticket_id, v_price, p_method, 'PAYMENT'); +    UPDATE tickets SET status = 'PAID' WHERE ticket_id = p_ticket_id; +    COMMIT; +  EXCEPTION +    WHEN NO_DATA_FOUND THEN ROLLBACK; RAISE_APPLICATION_ERROR(-20021, 'Ticket not found.'); +    WHEN OTHERS THEN ROLLBACK; RAISE; +  END pay_ticket; + +  PROCEDURE cancel_ticket(p_ticket_id IN NUMBER, p_reason IN VARCHAR2) IS +    v_status    tickets.status%TYPE; +    v_price     tickets.price%TYPE; +    v_departure schedules.departure_time%TYPE; +  BEGIN +    SELECT t.status, t.price, s.departure_time INTO v_status, v_price, v_departure +      FROM tickets t JOIN schedules s ON s.schedule_id = t.schedule_id +     WHERE t.ticket_id = p_ticket_id +       FOR UPDATE OF t.status; + +    IF v_status = 'CANCELLED' THEN +      RAISE_APPLICATION_ERROR(-20030, 'Ticket is already cancelled.'); +    ELSIF v_departure <= SYSDATE THEN +      RAISE_APPLICATION_ERROR(-20031, 'Schedule has already departed; cancellation not allowed.'); +    END IF; + +    -- V├⌐ ─æ├ú thanh to├ín th├¼ ho├án lß║íi to├án bß╗Ö tiß╗ün mß║╖t +    IF v_status = 'PAID' THEN +      INSERT INTO payments (ticket_id, amount, method, payment_type) +      VALUES (p_ticket_id, v_price, 'CASH', 'REFUND'); +    END IF; + +    UPDATE tickets +       SET status = 'CANCELLED', cancelled_at = SYSTIMESTAMP, cancel_reason = p_reason +     WHERE ticket_id = p_ticket_id; +    COMMIT; +  EXCEPTION +    WHEN NO_DATA_FOUND THEN ROLLBACK; RAISE_APPLICATION_ERROR(-20032, 'Ticket not found.'); +    WHEN OTHERS THEN ROLLBACK; RAISE; +  END cancel_ticket; + +END pkg_ticket; +/ + +CREATE OR REPLACE PACKAGE pkg_schedule AS +  -- Hß╗ºy chuyß║┐n: hß╗ºy to├án bß╗Ö v├⌐ c├▓n hiß╗çu lß╗▒c, ho├án tiß╗ün v├⌐ ─æ├ú thanh to├ín, rß╗ôi hß╗ºy chuyß║┐n +  PROCEDURE cancel_schedule(p_schedule_id IN NUMBER, p_reason IN VARCHAR2); +END pkg_schedule; +/ + +CREATE OR REPLACE PACKAGE BODY pkg_schedule AS + +  PROCEDURE cancel_schedule(p_schedule_id IN NUMBER, p_reason IN VARCHAR2) IS +    v_status schedules.status%TYPE; +  BEGIN +    SELECT status INTO v_status FROM schedules WHERE schedule_id = p_schedule_id FOR UPDATE; +    IF v_status <> 'SCHEDULED' THEN +      RAISE_APPLICATION_ERROR(-20051, 'Only SCHEDULED trips can be cancelled.'); +    END IF; + +    -- Ho├án tiß╗ün c├íc v├⌐ ─æ├ú thanh to├ín +    INSERT INTO payments (ticket_id, amount, method, payment_type) +    SELECT ticket_id, price, 'CASH', 'REFUND' +      FROM tickets WHERE schedule_id = p_schedule_id AND status = 'PAID'; + +    UPDATE tickets +       SET status = 'CANCELLED', cancelled_at = SYSTIMESTAMP, +           cancel_reason = SUBSTR('Trip cancelled: ' || p_reason, 1, 200) +     WHERE schedule_id = p_schedule_id AND status <> 'CANCELLED'; + +    -- L├║c n├áy kh├┤ng c├▓n v├⌐ hiß╗çu lß╗▒c n├¬n trg_schedules_check_cancel cho qua +    UPDATE schedules SET status = 'CANCELLED' WHERE schedule_id = p_schedule_id; +    COMMIT; +  EXCEPTION +    WHEN NO_DATA_FOUND THEN ROLLBACK; RAISE_APPLICATION_ERROR(-20050, 'Schedule not found.'); +    WHEN OTHERS THEN ROLLBACK; RAISE; +  END cancel_schedule; + +END pkg_schedule; +/ + +-- Dß╗½ng nß║┐u c├│ object bß╗ï lß╗ùi bi├¬n dß╗ïch +SELECT name, type, line, text FROM user_errors ORDER BY name, sequence; +DECLARE +  v_errors NUMBER; +BEGIN +  SELECT COUNT(*) INTO v_errors FROM user_errors; +  IF v_errors > 0 THEN +    RAISE_APPLICATION_ERROR(-20999, 'Compilation errors: ' || v_errors); +  END IF; +END; +/ + +EXIT diff --git a/database/05_views.sql b/database/05_views.sql new file mode 100644 index 0000000..63d4fb6 --- /dev/null +++ b/database/05_views.sql @@ -0,0 +1,56 @@ +WHENEVER SQLERROR EXIT FAILURE ROLLBACK +SET DEFINE OFF +SET SQLBLANKLINES ON +SET SERVEROUTPUT ON SIZE UNLIMITED + +-- Thß╗æng k├¬ tß╗½ng chuyß║┐n: ghß║┐ ─æ├ú b├ín, ghß║┐ trß╗æng, tß╗╖ lß╗ç lß║Ñp ─æß║ºy, v├⌐ hß╗ºy, doanh thu thß╗▒c (─æ├ú trß╗½ ho├án tiß╗ün). +-- C├│ th├¬m route_id, origin, destination, ticket_price ─æß╗â m├án B├ín v├⌐ lß╗ìc theo tuyß║┐n v├á khoß║úng gi├í; +-- vehicle_id, driver_id ─æß╗â m├án Lß╗ïch chß║íy ─æß╗ìc tß╗½ view (seller kh├┤ng c├│ quyß╗ün ─æß╗ìc bß║úng DRIVERS). +CREATE OR REPLACE VIEW v_trip_statistics AS +SELECT s.schedule_id, +       s.route_id, +       s.vehicle_id, +       s.driver_id, +       r.route_name, +       r.origin, +       r.destination, +       s.departure_time, +       s.arrival_time, +       s.ticket_price, +       s.status                                                AS schedule_status, +       v.plate_number, +       v.vehicle_type, +       d.full_name                                             AS driver_name, +       v.seat_count, +       COUNT(CASE WHEN t.status <> 'CANCELLED' THEN 1 END)     AS seats_sold, +       v.seat_count - COUNT(CASE WHEN t.status <> 'CANCELLED' THEN 1 END) AS seats_available, +       ROUND(100 * COUNT(CASE WHEN t.status <> 'CANCELLED' THEN 1 END) / v.seat_count, 1) AS occupancy_pct, +       COUNT(CASE WHEN t.status = 'CANCELLED' THEN 1 END)      AS tickets_cancelled, +       NVL(SUM(p.net_amount), 0)                               AS revenue +  FROM schedules s +  JOIN routes   r ON r.route_id   = s.route_id +  JOIN vehicles v ON v.vehicle_id = s.vehicle_id +  JOIN drivers  d ON d.driver_id  = s.driver_id +  LEFT JOIN tickets t ON t.schedule_id = s.schedule_id +  -- Gß╗Öp thanh to├ín theo v├⌐ tr╞░ß╗¢c khi join ─æß╗â doanh thu kh├┤ng bß╗ï nh├ón ─æ├┤i +  LEFT JOIN (SELECT ticket_id, +                    SUM(CASE payment_type WHEN 'PAYMENT' THEN amount ELSE -amount END) AS net_amount +               FROM payments +              GROUP BY ticket_id) p ON p.ticket_id = t.ticket_id + GROUP BY s.schedule_id, s.route_id, s.vehicle_id, s.driver_id, r.route_name, r.origin, r.destination, +          s.departure_time, s.arrival_time, s.ticket_price, s.status, +          v.plate_number, v.vehicle_type, d.full_name, v.seat_count; + +-- Dß╗½ng nß║┐u c├│ object bß╗ï lß╗ùi bi├¬n dß╗ïch +SELECT name, type, line, text FROM user_errors ORDER BY name, sequence; +DECLARE +  v_errors NUMBER; +BEGIN +  SELECT COUNT(*) INTO v_errors FROM user_errors; +  IF v_errors > 0 THEN +    RAISE_APPLICATION_ERROR(-20999, 'Compilation errors: ' || v_errors); +  END IF; +END; +/ + +EXIT diff --git a/database/09_test_scenarios.sql b/database/09_test_scenarios.sql new file mode 100644 index 0000000..baaa6ea --- /dev/null +++ b/database/09_test_scenarios.sql @@ -0,0 +1,134 @@ +-- Kß╗ïch bß║ún kiß╗âm thß╗¡ nghiß╗çp vß╗Ñ (chß║íy bß║▒ng TRANSPORT). In PASS/FAIL tß╗½ng kß╗ïch bß║ún. +-- Tß╗▒ tß║ío dß╗» liß╗çu test ri├¬ng (biß╗ân sß╗æ 99Z-999.99, S─ÉT 0999xxxxxx) v├á tß╗▒ dß╗ìn ß╗ƒ cuß╗æi. +WHENEVER SQLERROR EXIT FAILURE ROLLBACK +SET DEFINE OFF +SET SQLBLANKLINES ON +SET SERVEROUTPUT ON SIZE UNLIMITED + +DECLARE +  g_fail    PLS_INTEGER := 0; +  v_route   NUMBER; +  v_vehicle NUMBER; +  v_driver  NUMBER; +  v_sched   NUMBER; +  v_t1      NUMBER; +  v_t2      NUMBER; +  v_n       NUMBER; +  v_m       NUMBER; +  v_log     NUMBER; + +  -- Ghi nhß║¡n kß║┐t quß║ú mß╗Öt kiß╗âm tra +  PROCEDURE ok(p_name VARCHAR2, p_cond BOOLEAN) IS +  BEGIN +    IF p_cond THEN +      DBMS_OUTPUT.PUT_LINE('PASS  ' || p_name); +    ELSE +      g_fail := g_fail + 1; +      DBMS_OUTPUT.PUT_LINE('FAIL  ' || p_name); +    END IF; +  END ok; + +  -- Chß║íy mß╗Öt khß╗æi PL/SQL ─æß╗Öng v├á kiß╗âm tra ─æ├║ng m├ú lß╗ùi mong ─æß╗úi +  PROCEDURE expect_error(p_name VARCHAR2, p_code NUMBER, p_block VARCHAR2) IS +  BEGIN +    EXECUTE IMMEDIATE p_block; +    ok(p_name || ' (expected ' || p_code || ', got no error)', FALSE); +  EXCEPTION +    WHEN OTHERS THEN +      ok(p_name || ' (expected ' || p_code || ', got ' || SQLCODE || ')', SQLCODE = p_code); +  END expect_error; + +  -- Dß╗ìn to├án bß╗Ö dß╗» liß╗çu test (gß╗ìi cß║ú ß╗ƒ ─æß║ºu ─æß╗â chß║íy lß║íi ─æ╞░ß╗úc sau mß╗Öt lß║ºn lß╗ùi) +  PROCEDURE cleanup IS +  BEGIN +    DELETE FROM payments WHERE ticket_id IN ( +      SELECT t.ticket_id FROM tickets t JOIN schedules s ON s.schedule_id = t.schedule_id +        JOIN vehicles v ON v.vehicle_id = s.vehicle_id WHERE v.plate_number = '99Z-999.99'); +    DELETE FROM tickets WHERE schedule_id IN ( +      SELECT s.schedule_id FROM schedules s JOIN vehicles v ON v.vehicle_id = s.vehicle_id +       WHERE v.plate_number = '99Z-999.99'); +    DELETE FROM schedules WHERE vehicle_id IN (SELECT vehicle_id FROM vehicles WHERE plate_number = '99Z-999.99'); +    DELETE FROM passengers WHERE phone LIKE '0999%'; +    DELETE FROM vehicles WHERE plate_number = '99Z-999.99'; +    DELETE FROM drivers  WHERE license_no = 'TEST-LIC-1'; +    DELETE FROM routes   WHERE route_name = 'TEST Route'; +    COMMIT; +  END cleanup; +BEGIN +  cleanup; + +  -- Dß╗» liß╗çu test: xe 16 chß╗ù, chuyß║┐n khß╗ƒi h├ánh sau 2 ng├áy +  INSERT INTO routes (route_name, origin, destination, distance_km, duration_min, base_price) +  VALUES ('TEST Route', 'TEST A', 'TEST B', 10, 60, 100000) RETURNING route_id INTO v_route; +  INSERT INTO vehicles (plate_number, vehicle_type, seat_count, status) +  VALUES ('99Z-999.99', 'Test 16', 16, 'ACTIVE') RETURNING vehicle_id INTO v_vehicle; +  INSERT INTO drivers (full_name, id_card, phone, license_no, license_class, license_expiry, status) +  VALUES ('Test Driver', '999999999999', '0999999999', 'TEST-LIC-1', 'D', TRUNC(SYSDATE) + 365, 'ACTIVE') +  RETURNING driver_id INTO v_driver; +  INSERT INTO schedules (route_id, vehicle_id, driver_id, departure_time, arrival_time, ticket_price) +  VALUES (v_route, v_vehicle, v_driver, TRUNC(SYSDATE) + 2 + 8/24, TRUNC(SYSDATE) + 2 + 9/24, 100000) +  RETURNING schedule_id INTO v_sched; +  COMMIT; + +  -- 1. ─Éß║╖t v├⌐ hß╗úp lß╗ç +  pkg_ticket.book_ticket(v_sched, 'Test Passenger', '0999000001', NULL, 1, v_t1); +  SELECT COUNT(*) INTO v_n FROM tickets WHERE ticket_id = v_t1 AND status = 'BOOKED' AND sold_by = USER; +  ok('1. book a free seat', v_n = 1); + +  -- 2. ─Éß║╖t tr├╣ng ghß║┐ +  expect_error('2. double booking is rejected', -20003, +    'DECLARE x NUMBER; BEGIN pkg_ticket.book_ticket(' || v_sched || ', ''P2'', ''0999000002'', NULL, 1, x); END;'); + +  -- 3. Ghß║┐ v╞░ß╗út sß╗⌐c chß╗⌐a +  expect_error('3. seat beyond capacity is rejected', -20001, +    'DECLARE x NUMBER; BEGIN pkg_ticket.book_ticket(' || v_sched || ', ''P3'', ''0999000003'', NULL, 17, x); END;'); + +  -- 4. Thanh to├ín +  pkg_ticket.pay_ticket(v_t1, 'CASH'); +  SELECT COUNT(*) INTO v_n FROM payments WHERE ticket_id = v_t1 AND payment_type = 'PAYMENT'; +  ok('4a. payment row created', v_n = 1); +  SELECT COUNT(*) INTO v_n FROM tickets WHERE ticket_id = v_t1 AND status = 'PAID'; +  ok('4b. ticket is PAID', v_n = 1); +  expect_error('4c. paying twice is rejected', -20020, +    'BEGIN pkg_ticket.pay_ticket(' || v_t1 || ', ''CASH''); END;'); + +  -- 5. Hß╗ºy v├⌐ ─æ├ú thanh to├ín -> ho├án tiß╗ün, doanh thu r├▓ng = 0 +  pkg_ticket.cancel_ticket(v_t1, 'test cancel'); +  SELECT COUNT(*) INTO v_n FROM payments WHERE ticket_id = v_t1 AND payment_type = 'REFUND'; +  ok('5a. refund row created', v_n = 1); +  SELECT revenue INTO v_n FROM v_trip_statistics WHERE schedule_id = v_sched; +  ok('5b. net revenue is 0 after refund', v_n = 0); + +  -- 6. Hß╗ºy lß║ºn 2 +  expect_error('6. cancelling twice is rejected', -20030, +    'BEGIN pkg_ticket.cancel_ticket(' || v_t1 || ', ''again''); END;'); + +  -- 7. Ghß║┐ ─æ├ú hß╗ºy ─æ╞░ß╗úc ─æß║╖t lß║íi +  pkg_ticket.book_ticket(v_sched, 'Test Passenger', '0999000001', NULL, 1, v_t2); +  ok('7. cancelled seat can be booked again', v_t2 IS NOT NULL AND v_t2 <> v_t1); + +  -- 8. Hß╗ºy chuyß║┐n: kh├┤ng cho UPDATE trß╗▒c tiß║┐p khi c├▓n v├⌐; cancel_schedule hß╗ºy v├⌐ + ho├án tiß╗ün +  pkg_ticket.pay_ticket(v_t2, 'CARD'); +  expect_error('8a. direct schedule cancel is blocked', -20052, +    'UPDATE schedules SET status = ''CANCELLED'' WHERE schedule_id = ' || v_sched); +  pkg_schedule.cancel_schedule(v_sched, 'test'); +  SELECT COUNT(*) INTO v_n FROM tickets WHERE schedule_id = v_sched AND status <> 'CANCELLED'; +  ok('8b. all tickets cancelled', v_n = 0); +  SELECT COUNT(*) INTO v_n FROM payments WHERE ticket_id = v_t2 AND payment_type = 'REFUND'; +  ok('8c. paid ticket refunded', v_n = 1); +  SELECT COUNT(*) INTO v_n FROM schedules WHERE schedule_id = v_sched AND status = 'CANCELLED'; +  ok('8d. schedule is CANCELLED', v_n = 1); +  expect_error('8e. cancelling a cancelled schedule is rejected', -20051, +    'BEGIN pkg_schedule.cancel_schedule(' || v_sched || ', ''again''); END;'); + +  -- @@BACKUP_TESTS@@ + +  -- @@STAFF_TESTS@@ + +  cleanup; +  DBMS_OUTPUT.PUT_LINE(CASE WHEN g_fail = 0 THEN 'ALL TESTS PASSED' +                            ELSE g_fail || ' TEST(S) FAILED' END); +END; +/ + +EXIT
